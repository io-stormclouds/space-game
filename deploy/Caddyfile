# The client and the game server on one origin (R-25): in remote mode (?api=remote, remembered in
# localStorage) the client logs in through /api (the session cookie is first-party) and connects to
# wss://<host>/ws by itself. /metrics stays inside (Prometheus scrapes game-server:8080 directly).
{$SITE_ADDRESS}

handle /ws {
	reverse_proxy game-server:8080
}

handle /api/* {
	reverse_proxy game-server:8080
}

handle /health {
	reverse_proxy game-server:8080
}

handle {
	root * /srv
	try_files {path} /index.html
	file_server
}
