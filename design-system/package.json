{
  "name": "@space-game/hud-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./css/tokens.css": "./src/tokens/tokens.generated.css",
    "./css/base.css": "./src/styles/base.css",
    "./css/hud-frame.css": "./src/components/HudFrame/HudFrame.css",
    "./css/rts-button.css": "./src/components/RTSButton/RTSButton.css",
    "./css/resource-panel.css": "./src/components/ResourcePanel/ResourcePanel.css",
    "./css/command-card.css": "./src/components/CommandCard/CommandCard.css"
  },
  "scripts": {
    "dev": "vite",
    "tokens": "tsx scripts/generate-tokens.ts",
    "tokens:check": "tsx scripts/generate-tokens.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens:check && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
